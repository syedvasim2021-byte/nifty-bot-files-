# ---- Zerodha Kite Connect credentials ----
# From developers.kite.trade -> My Apps
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Filled in automatically after the daily login step (see auth.py). Leave blank initially.
KITE_ACCESS_TOKEN=

# ---- Capital & risk settings ----
CAPITAL=200000
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=4
MAX_LOTS_PER_TRADE=2

# Breakout+retest strategy trades a FIXED number of lots (per your spec), not %-risk sized.
STRATEGY_FIXED_LOTS=1

# ---- Strategy / instrument settings ----
UNDERLYING_INDEX=NIFTY 50
OPTION_SYMBOL_PREFIX=NIFTY
CANDLE_INTERVAL=15minute
CANDLE_INTERVAL_MINUTES=15
# Short poll interval so stop-loss breaches (checked vs live LTP) are caught fast,
# even though the candle signal itself only updates once every 15 minutes.
POLL_INTERVAL_SECONDS=20
SQUARE_OFF_TIME=15:20

# ---- Legacy settings (unused by the breakout+retest strategy, kept for reference) ----
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PCT=30
TARGET_PCT=50

# ---- Safety switch ----
# true  = simulate everything, no real orders sent (ALWAYS start here)
# false = real orders go to the exchange with real money
DRY_RUN=true
